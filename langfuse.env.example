# Copy to keys/langfuse.env; existing process environment variables take priority.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Use the region of your Langfuse project, or your self-hosted instance URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
# true uploads text prompts and results; false records metadata/timing/usage only.
# Inline image/document data is always omitted by this project's instrumentation.
LANGFUSE_CAPTURE_CONTENT=true
